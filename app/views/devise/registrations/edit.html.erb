<% title = t('views.common.title_edit', name: User.model_name.human.downcase) %>
<% content_for :title, title %>

<h1><%= title %></h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="field">
    <%= f.label :postal_code %><br />
    <%= f.text_field :postal_code, autocomplete: "postal-code" %>
  </div>

  <div class="field">
    <%= f.label :address %><br />
    <%= f.text_field :address, autocomplete: "street-address" %>
  </div>

  <div class="field">
    <%= f.label :self_introduction %><br />
    <%= f.text_area :self_introduction, rows: 4 %>
  </div>

  <div class="field">
    <%= f.label :password %>
    <i>(<%= t('devise.registrations.edit.leave_blank_if_you_don_t_want_to_change_it', default: 'leave blank if you don’t want to change it') %>)</i><br />
    <%= f.password_field :password, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :current_password %>
    <i>(<%= t('devise.registrations.edit.we_need_your_current_password_to_confirm_your_changes', default: 'we need your current password to confirm your changes') %>)</i><br />
    <%= f.password_field :current_password, autocomplete: "current-password" %>
  </div>

  <div class="actions">
    <%= f.submit t('.update', default: t('devise.registrations.edit.update', default: 'Update')) %>
  </div>
<% end %>

<hr>

<h3><%= t('devise.registrations.edit.cancel_my_account', default: 'Cancel my account') %></h3>

<%= button_to t('devise.registrations.edit.cancel_my_account', default: 'Cancel my account'),
              registration_path(resource_name),
              data: { confirm: t('devise.registrations.edit.are_you_sure', default: 'Are you sure?') },
              method: :delete %>

<nav class="page-nav">
  <%= link_to t('views.common.show', name: User.model_name.human.downcase), @user %> |
  <%= link_to t('views.common.back', name: i18n_pluralize(User.model_name.human.downcase)), users_path %>
</nav>
